{
  // 기존 Worker 이름과 일치해야 같은 곳으로 배포된다.
  // 커스텀 도메인·라우트는 대시보드 설정을 그대로 쓰므로 여기에 적지 않는다.
  // 커스텀 도메인 yupumjeongri.xyz + 라우트 www.yupumjeongri.xyz/* (www 는 worker/index.js 가 apex 로 301).
  "name": "yupumjeongri-xyz",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 없는 주소에 빈 404 대신 dist/404.html 을 404 상태로 돌려준다
    "not_found_handling": "404-page",
    // 모든 요청이 Worker 를 먼저 탄다. www → apex 301 은 Worker 안에서만 할 수 있는데
    // (www 는 DNS 레코드가 외부 관리라 커스텀 도메인 대신 라우트 www.yupumjeongri.xyz/* 로 붙였다)
    // run_worker_first 는 경로 패턴만 받고 호스트를 구분하지 못한다. 트래픽이 작아 비용 차이는 없다.
    "run_worker_first": true
  },
  // 방문·상담 깔때기 기록 (worker/funnel.js). 스키마는 migrations/ — 바꾸면
  // npx wrangler d1 migrations apply yupumjeongri-funnel --remote
  "d1_databases": [
    {
      "binding": "FUNNEL_DB",
      "database_name": "yupumjeongri-funnel",
      "database_id": "6e9fd8d1-4803-4ccd-9b72-5bf0765909c0"
    }
  ],
  // 매일 09:00 KST 깔때기 Slack 요약은 2026-10-08 껐다. 빈 배열이어야 배포 때 기존 cron 이 지워진다
  // (triggers 를 통째로 빼면 대시보드에 남은 cron 이 그대로 돈다).
  "triggers": {
    "crons": []
  }
}

---
import QuickConsult from './QuickConsult.astro';

interface Props {
  title?: string;
  body?: string;
  /** 지역 페이지에서 페이지의 지역명을 신청과 함께 보낸다 */
  regionHint?: string;
}

const {
  title = '어디서부터 시작해야 할지 모르겠다면',
  body = '주거 형태와 짐의 양만 알려주셔도 대략적인 범위와 비용을 안내드립니다. 결정은 그다음에 하셔도 됩니다.',
  regionHint,
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{title}</h2>
      <p>{body}</p>
      {/* 버튼으로 상담 페이지에 한 번 더 보내지 않고 이 자리에서 접수한다 */}
      <QuickConsult id="cta" tone="dark" regionHint={regionHint} label="휴대폰 번호를 남겨주시면 최대한 빠르게 연락드립니다" />
      <p class="cta__alt"><a href="/cost/">비용 먼저 보기</a></p>
    </div>
  </div>
</section>

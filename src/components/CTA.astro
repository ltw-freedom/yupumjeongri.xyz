---
import { site } from '../data/site';
import KakaoButton from './KakaoButton.astro';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = '어디서부터 시작해야 할지 모르겠다면',
  body = '주거 형태와 짐의 양만 알려주셔도 대략적인 범위와 비용을 안내드립니다. 결정은 그다음에 하셔도 됩니다.',
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{title}</h2>
      <p>{body}</p>
      <div class="cta__actions">
        <a class="button button--primary" href={site.consultPath}>무료 상담 신청하기</a>
        <KakaoButton />
        <a class="button button--ghost" href="/cost/">비용 먼저 보기</a>
      </div>
      <p class="cta__reassure">{site.responsePromise}. 상담·방문 견적 무료, 계약 의무 없음.</p>
    </div>
  </div>
</section>

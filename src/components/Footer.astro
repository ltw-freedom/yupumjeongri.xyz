---
import { site } from '../data/site';
import { services } from '../data/services';
import { regions } from '../data/areas';
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div>
        <strong>{site.name}</strong>
        <p>{site.slogan} — {site.sloganSub}</p>
        <p>
          <a href={site.consultPath}>상담 신청하기</a>
        </p>
      </div>
      <div>
        <strong>서비스</strong>
        <ul>
          {
            services.map((service) => (
              <li>
                <a href={`/service/${service.slug}/`}>{service.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <strong>지역</strong>
        <ul>
          {
            regions.map((region) => (
              <li>
                <a href={`/area/${region.slug}/`}>{region.name} 유품정리</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="note">{site.legalNotice}</p>
    <p class="note">© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

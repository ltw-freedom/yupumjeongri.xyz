---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { site } from '../../data/site';
import { faqSchema } from '../../data/schema';
import { basePrices, unitRates } from '../../data/pricing';

const factors = [
  {
    name: '물품 양',
    detail: '실제 반출되는 부피가 기준입니다. 평형보다 짐의 양이 비용을 좌우합니다.',
  },
  {
    name: '주거 형태와 층수',
    detail: '엘리베이터 유무, 계단 운반 층수, 사다리차 필요 여부에 따라 인력과 장비가 달라집니다.',
  },
  {
    name: '반출 동선',
    detail: '차량 진입 가능 위치부터 현관까지의 거리, 지하주차장 높이 제한, 지정 반출 동선 여부.',
  },
  {
    name: '폐기물 종류',
    detail: '가전·가구·생활 폐기물은 처리 경로와 비용이 다릅니다. 대형 폐기물은 별도 신고가 필요합니다.',
  },
  {
    name: '특수청소 포함 여부',
    detail: '고독사 현장은 오염 제거, 소독, 탈취가 선행되며 소독 횟수에 따라 비용이 달라집니다.',
  },
  {
    name: '작업 시간대',
    detail: '단지 규정으로 야간·주말 작업이 필요한 경우 인력 배치가 달라집니다.',
  },
  {
    name: '마감 복구',
    detail: '도배·장판 등 원상복구가 필요하면 별도 견적으로 안내드립니다.',
  },
];

const faqs = [
  {
    q: '왜 확정가가 아니라 범위로 안내하나요?',
    a: '유품정리 비용은 평형이 아니라 실제 반출되는 짐의 양으로 정해지기 때문입니다. 같은 평형이라도 물량에 따라 금액이 달라져, 범위를 먼저 공개하고 현장 확인 후 그 근거 단가로 확정 견적을 드리는 방식이 가장 정확합니다.',
  },
  {
    q: '방문 없이 금액을 알 수 있나요?',
    a: '위 기준 가격표로 대략적인 범위를 가늠하실 수 있고, 사진을 보내주시면 상담 회신에서 범위를 훨씬 좁혀 드립니다. 확정 견적은 현장 확인 후에 나옵니다.',
  },
  {
    q: '견적 이후에 금액이 올라가지 않나요?',
    a: '현장 확인 시 확인되지 않았던 조건(자재 아래 오염, 추가 공간 등)이 나오면 작업 전에 먼저 알려드리고 진행 여부를 확인받습니다.',
  },
  {
    q: '쓸 만한 물건은 비용에서 차감되나요?',
    a: '재사용·매각 가능한 물품이 있으면 목록으로 안내드리고, 협의 후 정산에 반영합니다.',
  },
  {
    q: '보증금 정산에 쓸 견적서를 받을 수 있나요?',
    a: '가능합니다. 임대인·임차인 정산에 쓸 수 있도록 항목별로 구분해 작성해 드립니다.',
  },
];
---

<BaseLayout
  title={`유품정리 비용 | 원룸 40만원대부터, 기준 가격 공개 - ${site.name}`}
  description="유품정리 비용 기준 가격을 공개합니다. 원룸 40만~90만원, 투룸 90만~160만원, 20평대 150만~250만원. 폐기물 톤당 단가와 인력·장비 단가까지 그대로 안내합니다."
  jsonLd={[faqSchema(faqs)]}
>
  <Breadcrumb items={[{ label: '비용' }]} />

  <section class="section">
    <div class="container">
      <h1>유품정리 비용</h1>
      <p class="lead">
        업체 대부분은 가격을 공개하지 않고 방문 견적부터 권합니다. 저희는 반대로 갑니다. 기준 가격과
        견적을 구성하는 단가를 먼저 공개하고, 그 범위 안에서 견적을 냅니다.
      </p>

      <h2>주거 형태별 기준 가격</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">주거 형태</th>
              <th scope="col">기준 범위</th>
              <th scope="col">범위가 달라지는 조건</th>
            </tr>
          </thead>
          <tbody>
            {
              basePrices.map((row) => (
                <tr>
                  <th scope="row">{row.type}</th>
                  <td>{row.range}</td>
                  <td>{row.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        시장에 공개된 가격 자료와 저희 단가를 반영해 정한 기준입니다. 비용을 정하는 것은 평형이 아니라
        실제 반출되는 짐의 양이라서, 짐이 적으면 범위 아래에서 끝나기도 합니다. 확정 금액은 현장 확인 후
        항목별 견적서로 드리며, 견적서에 없는 금액은 청구하지 않습니다.
      </p>

      <h2>견적서를 구성하는 단가</h2>
      <p>
        견적서의 합계가 어떻게 나오는지 계산 근거를 그대로 공개합니다. 받아보신 견적서의 각 항목을 아래
        단가와 대조해 보실 수 있습니다.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">단가</th>
              <th scope="col">설명</th>
            </tr>
          </thead>
          <tbody>
            {
              unitRates.map((row) => (
                <tr>
                  <th scope="row">{row.item}</th>
                  <td>{row.rate}</td>
                  <td>{row.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>견적에 영향을 주는 요소</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">설명</th>
            </tr>
          </thead>
          <tbody>
            {
              factors.map((factor) => (
                <tr>
                  <th scope="row">{factor.name}</th>
                  <td>{factor.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>견적 절차</h2>
      <ol class="steps">
        <li><strong>사진 상담</strong>현장 사진 몇 장으로 대략적인 범위를 안내드립니다.</li>
        <li><strong>현장 확인</strong>방문해 물품 양과 반출 동선을 확인합니다.</li>
        <li><strong>항목별 견적서</strong>작업 항목과 금액을 구분해 서면으로 드립니다.</li>
        <li><strong>확정 · 일정 조율</strong>동의하신 범위 안에서만 작업합니다.</li>
      </ol>

      <p class="note">
        견적서에 없는 작업은 임의로 진행하지 않습니다. 추가가 필요하면 작업 전에 먼저 확인받습니다.
      </p>

      <FAQ items={faqs} />

      <h2>함께 보면 좋은 페이지</h2>
      <ul class="link-list">
        <li><a href="/process/">진행 과정</a></li>
        <li><a href="/service/yupumjeongri/">유품정리 서비스</a></li>
        <li><a href="/service/godoksa-yupumjeongri/">고독사 유품정리</a></li>
        <li><a href="/column/">칼럼</a></li>
      </ul>
    </div>
  </section>

  <CTA title="견적부터 받아보세요" body="사진 몇 장이면 대략적인 범위를 알려드립니다. 방문 견적도 비용은 발생하지 않습니다." />
</BaseLayout>

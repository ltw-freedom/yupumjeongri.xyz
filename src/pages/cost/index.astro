---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import PriceTable from '../../components/PriceTable.astro';
import { site } from '../../data/site';
import { faqSchema, priceOffers, webPage } from '../../data/schema';
import { contentDate } from '../../data/contentDates';
import {
  unitRates,
  priceAnswerCore,
  pricesAsOf,
  vatLabel,
  priceRow,
  marketSurveyedAt,
  volumeMatrix,
  inlineRange,
  estimator,
} from '../../data/pricing';
import QuickConsult from '../../components/QuickConsult.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../../data/columnLinks';
import EstimateCalc from '../../components/EstimateCalc.astro';

const factors = [
  {
    name: '물품 양',
    detail: '실제 반출되는 부피가 기준입니다. 평형보다 짐의 양이 비용을 좌우합니다.',
  },
  {
    name: '주거 형태와 층수',
    detail: '엘리베이터 유무, 계단 운반 층수, 사다리차 필요 여부에 따라 인력과 장비가 달라집니다.',
  },
  {
    name: '반출 동선',
    detail: '차량 진입 가능 위치부터 현관까지의 거리, 지하주차장 높이 제한, 지정 반출 동선 여부.',
  },
  {
    name: '폐기물 종류',
    detail: '가전·가구·생활 폐기물은 처리 경로와 비용이 다릅니다. 대형 폐기물은 별도 신고가 필요합니다.',
  },
  {
    name: '특수청소 포함 여부',
    detail: '고독사 현장은 오염 제거, 소독, 탈취가 선행되며 소독 횟수에 따라 비용이 달라집니다.',
  },
  {
    name: '작업 시간대',
    detail: '단지 규정으로 야간·주말 작업이 필요한 경우 인력 배치가 달라집니다.',
  },
  {
    name: '마감 복구',
    detail: '도배·장판 등 원상복구가 필요하면 별도 견적으로 안내드립니다.',
  },
];

/**
 * 견적서 비교 체크리스트 — "유품정리 비용" 검색의 상위 결과는 가격표보다 "업체 고르는 기준"류 안내 글이다
 * (2026-10-06 네이버 모바일, docs/seo-naver.md 4-2). 비용을 찾는 사람은 이미 견적서 몇 장을 놓고 비교하는 중이라
 * 그 비교를 돕는 문단을 둔다. 지어낸 시세·평균값은 쓰지 않고, 우리 단가표(unitRates)와 같은 기준으로만 쓴다.
 */
const compareChecks = [
  {
    name: '부가세 포함 여부',
    detail: `같은 숫자라도 부가세 별도면 10%가 더 붙습니다. 이 페이지의 금액은 전부 ${vatLabel}입니다. 견적서끼리 비교할 때는 같은 기준으로 맞춰 보세요.`,
  },
  {
    name: '폐기물 처리비가 합계에 들어 있는지',
    detail: '"폐기물 별도"로 적힌 견적은 작업 뒤 합계가 늘어납니다. 들어 있다면 몇 톤 차량 몇 대 기준인지 확인하세요. 저희는 1톤 차량 1대 단위로 적습니다.',
  },
  {
    name: '몇 명이 며칠 하는 금액인지',
    detail: '인력과 작업일이 빠진 총액은 다른 견적과 비교할 수 없습니다. 인원 × 일수가 적혀 있어야 금액이 싼지 비싼지 판단할 수 있습니다.',
  },
  {
    name: '"필요 시 별도" 항목',
    detail: '사다리차·특수청소·소독처럼 "필요 시 별도"로만 적힌 항목은 금액이 비어 있는 것과 같습니다. 필요해질 때 얼마인지 단가를 받아 두세요.',
  },
  {
    name: '견적서 밖의 작업이 생기면 어떻게 하는지',
    detail: '현장에서 새 조건이 나왔을 때 작업 전에 알리고 동의를 받는지, 끝난 뒤 청구하는지에 따라 최종 금액이 달라집니다.',
  },
];

const inline = inlineRange;

/**
 * 평수별 유품정리 비용 — '원룸 유품정리 비용', '30평 아파트 유품정리 비용' 같은 검색어의 정면 답(2026-11-08).
 * 표 칸은 계산기와 같은 식(pricing.ts volumeMatrix)으로 빌드 때 계산한다. 손으로 숫자를 적지 않는다.
 * 소제목마다 id 를 둬서 검색·AI 가 그 형태의 답 한 덩어리로 바로 링크할 수 있게 한다.
 */
const matrix = volumeMatrix();
const housingName = (key: string) => {
  const h = estimator.housing.find((row) => row.key === key)!;
  return [h.label, h.detail].filter(Boolean).join(' ');
};
const apt30 = priceRow('apt30');
const sizeHeadings: Record<string, string> = {
  oneroom: '원룸 유품정리 비용',
  tworoom: '투룸 유품정리 비용',
  apt20: '20평대 아파트 유품정리 비용',
  apt30: '30평 이상 아파트 유품정리 비용',
};
/** 숫자로 시작하는 직답 — 소제목 아래와 FAQ 가 같은 문장을 쓴다 */
const sizeAnswers = [
  ...matrix.map((row) => ({
    key: row.key,
    answer: `${inline(row.base.range)}입니다(${housingName(row.key)}, ${pricesAsOf} 기준, ${vatLabel}). ${row.cells
      .map((cell) => `짐이 ${cell.label}이면 ${inline(cell.range)}`)
      .join(', ')}으로 좁혀집니다(${vatLabel}).`,
  })),
  {
    key: apt30.key,
    // 상한은 지어내지 않는다 — basePrices 에도 없다. 방문 확인 뒤 확정한다는 사실만 적는다.
    answer: `${inline(apt30.range)}입니다(${housingName('apt30')}, ${pricesAsOf} 기준, ${vatLabel}). ${apt30.note}`,
  },
];
const sizeAnswer = (key: string) => sizeAnswers.find((s) => s.key === key)!.answer;

/**
 * 비용 계산 방법 — 견적이 무엇으로 정해지는지 산식 한 줄. 항목 이름은 unitRates 에서 가져온다.
 * 단가표에 없는 항목을 산식에 넣지 않게, 이름을 못 찾으면 빌드를 멈춘다.
 */
const unitName = (prefix: string) => {
  const row = unitRates.find((r) => r.item.startsWith(prefix));
  if (!row) throw new Error(`unitRates 에 '${prefix}' 항목이 없다 — /cost/ 비용 계산 방법 산식을 고칠 것`);
  return row;
};
const nameOf = (prefix: string) => unitName(prefix).item.replace(/\s*\(.*\)$/, '');
const formula = `${nameOf('폐기물 처리 (1톤')}(1톤 차량 대수 × 대당 단가) + ${nameOf('작업 인력')}(인원 × 1인 단가) + 필요 시 ${nameOf('사다리차')}(시간 × 시간당 단가) + 추가 시 ${nameOf('소독')} — ${vatLabel}`;

/** 알려 주면 범위가 좁혀지는 5가지 — 상담 폼의 상황 칸에 그대로 적으면 된다 */
const narrowChecks = [
  {
    name: '주거 형태',
    detail: `${matrix.map((row) => row.label).join(', ')}, 30평 이상 중 어디인지 알면 기준표의 행이 정해집니다.`,
  },
  {
    name: '층과 엘리베이터 여부',
    detail: `엘리베이터 없는 3층 이상이면 ${nameOf('사다리차')}나 계단 운반 인력이 붙을 수 있습니다.`,
  },
  {
    name: '짐의 양',
    detail: `${estimator.volume.map((v) => `${v.label}(${v.detail})`).join(', ')} 중 어디에 가까운지 알면 위 평수별 표의 칸이 정해집니다.`,
  },
  {
    name: '큰 가전·가구 수',
    detail: '냉장고·장롱·침대처럼 큰 품목은 생활 폐기물과 처리 경로가 달라 차량과 인력 계산이 바뀝니다.',
  },
  {
    name: '비워야 할 날짜',
    detail: '날짜가 정해져 있으면 그 날짜에 맞춰 인력과 일정을 잡습니다.',
  },
];

/**
 * FAQ 첫머리는 숫자로 답하는 비용 질문 — AI 답변 엔진이 인용하는 것은 '질문 문장 + 숫자 첫 문장' 꼴이다
 * (2026-10-23 ChatGPT·Gemini 실측). 금액은 전부 pricing.ts 에서 만든다.
 * 비용 직답은 priceAnswerCore — 고독사 특수청소 금액은 다른 브랜드 담당이라 넣지 않는다(2026-11-08).
 */
const faqs = [
  { q: '유품정리 비용은 얼마인가요?', a: priceAnswerCore() },
  { q: '원룸 유품정리 비용은 얼마인가요?', a: sizeAnswer('oneroom') },
  {
    q: '20평대 아파트 유품정리 비용은 얼마인가요?',
    a: `${pricesAsOf} 기준 ${inline(priceRow('apt20').range)}입니다(${vatLabel}). 같은 20평대라도 살림 규모가 크면 차량과 인력이 늘어 범위 위쪽에서, 짐이 적고 엘리베이터를 쓸 수 있으면 아래쪽에서 정해집니다. 30평 이상은 ${inline(apt30.range)}이며 방문 확인 후 확정합니다(${vatLabel}).`,
  },
  { q: '30평 아파트 유품정리 비용은 얼마인가요?', a: sizeAnswer('apt30') },
  {
    q: '유품정리 견적에 부가세가 포함되나요?',
    a: `이 사이트에 적힌 금액은 모두 부가세(VAT) 별도입니다. 다른 업체 견적과 비교하실 때는 부가세 포함 여부를 같은 기준으로 맞춰 보셔야 합니다. 같은 숫자라도 부가세 별도면 10%가 더 붙습니다.`,
  },
  {
    q: '유품정리 비용이 업체마다 크게 다른 이유는 무엇인가요?',
    a: '총액에 들어간 항목이 업체마다 다르기 때문인 경우가 많습니다. 부가세, 폐기물 처리비, 사다리차, 소독이 포함됐는지에 따라 같은 집도 금액이 크게 달라 보입니다. 위 "견적서 비교할 때 확인할 5가지"로 항목을 맞춰 보면 실제 차이를 알 수 있습니다.',
  },
  {
    q: '왜 확정가가 아니라 범위로 안내하나요?',
    a: '유품정리 비용은 평형이 아니라 실제 반출되는 짐의 양으로 정해지기 때문입니다. 같은 평형이라도 물량에 따라 금액이 달라져, 범위를 먼저 공개하고 현장 확인 후 그 근거 단가로 확정 견적을 드리는 방식이 가장 정확합니다.',
  },
  {
    q: '방문 없이 금액을 알 수 있나요?',
    a: '위 기준 가격표로 대략적인 범위를 가늠하실 수 있고, 상담 회신에서 주거 형태와 짐의 양을 여쭤보고 범위를 훨씬 좁혀 드립니다. 확정 견적은 현장 확인 후에 나옵니다.',
  },
  {
    q: '견적 이후에 금액이 올라가지 않나요?',
    a: '현장 확인 시 확인되지 않았던 조건(자재 아래 오염, 추가 공간 등)이 나오면 작업 전에 먼저 알려드리고 진행 여부를 확인받습니다.',
  },
  {
    q: '쓸 만한 물건은 비용에서 차감되나요?',
    a: '재사용·매각 가능한 물품이 있으면 목록으로 안내드리고, 협의 후 정산에 반영합니다.',
  },
  {
    q: '보증금 정산에 쓸 견적서를 받을 수 있나요?',
    a: '가능합니다. 임대인·임차인 정산에 쓸 수 있도록 항목별로 구분해 작성해 드립니다.',
  },
];

/**
 * 비용을 직접 다룬 칼럼 — /cost/ 에서 바로 링크한다(예전엔 /column/ 목록뿐이라 칼럼이 고아에 가까웠다).
 * 대한 담당 주제(비용·견적서)만 — 고독사 비용·시기 칼럼은 담당 지도 초안상 다른 브랜드 몫이라 넣지 않는다(2026-10-23).
 */
const costColumnIds = [
  'yupumjeongri-biyong-julineun-beop',
  'bumonim-yupumjeongri-jikjeop-biyong',
  'gyeonjeokseo-chugageum-hwagin',
  'bieoteo-jip-gyeonjeok',
];
const costColumns = (await getCollection('columns', ({ id, data }) => !data.draft && costColumnIds.includes(id))).sort(byNewest);

// 실제로 본문을 고친 날 — contentDates.ts 수동 지도. 스키마 dateModified 와 하단 '최종 수정' 줄이 같은 값을 쓴다.
const updated = contentDate('/cost/');
---

<BaseLayout
  title={`유품정리 비용 | 평수별 기준표·원룸 ${inline(priceRow('oneroom').range)}, ${vatLabel} - ${site.name}`}
  description={`유품정리 비용 공개 — 원룸 ${inline(priceRow('oneroom').range)}, 투룸 ${inline(priceRow('tworoom').range)}, 20평대 ${inline(priceRow('apt20').range)}, 30평 이상 ${inline(apt30.range)}(${vatLabel}). 평수별 표·단가·견적 받는 법.`}
  jsonLd={[priceOffers(), faqSchema(faqs), webPage({ path: '/cost/', name: '유품정리 비용', dateModified: updated })]}
>
  <Breadcrumb items={[{ label: '비용' }]} />

  <section class="section">
    <div class="container">
      <h1>유품정리 비용</h1>
      {/* 첫 문장은 질문("유품정리 비용 얼마?")에 대한 직답 — 검색·AI 발췌용 */}
      <p class="lead">
        <b>{priceAnswerCore()}</b> 업체 대부분은 가격을 공개하지 않고 방문 견적부터 권합니다. 저희는 반대로
        기준 가격과 견적을 구성하는 단가를 먼저 공개하고, 그 범위 안에서 견적을 냅니다.
      </p>

      <h2>주거 형태별 기준 가격 <small class="h-note">{pricesAsOf} 기준 · {vatLabel}</small></h2>
      <PriceTable />
      <p class="note">
        시장에 공개된 가격 자료와 저희 단가를 반영해 정한 기준입니다. 비용을 정하는 것은 평형이 아니라
        실제 반출되는 짐의 양이라서, 짐이 적으면 범위 아래에서 끝나기도 합니다. 확정 금액은 현장 확인 후
        항목별 견적서로 드리며, 견적서에 없는 금액은 청구하지 않습니다.
      </p>

      {/* '유품정리 비용'으로 들어온 방문이 가격표를 본 자리에서 바로 신청할 수 있게 (예전엔 첫 번호 칸이 계산기 안, 모바일 2,700px 아래) */}
      <QuickConsult id="cost" label="이 기준으로 견적을 받아 보세요 — 휴대폰 번호만 남기시면 최대한 빠르게 연락드립니다" />

      {/*
        평수별 유품정리 비용 — 계산기는 JS 로 결과를 그려 검색·AI 가 숫자를 못 읽는다. 같은 식의 결과를 정적 표로 둔다.
        price-table 클래스는 쓰지 않는다 — 좁은 화면에서 thead 를 숨겨, 4열 표의 '짐의 양' 머리글이 사라진다.
      */}
      <h2 id="pyeong">평수별 유품정리 비용 <small class="h-note">{pricesAsOf} 기준 · {vatLabel}</small></h2>
      <p>
        기준 범위를 짐의 양으로 좁힌 표입니다. 아래 계산기와 같은 식으로 계산했고 {estimator.roundTo / 10_000}만원 단위로
        반올림했습니다.{matrix.every((row) => row.cells.every((cell) => cell.withinBase)) && ' 표의 모든 칸은 위 기준 가격표 범위 안에 있습니다.'}
      </p>
      <div class="table-wrap">
        <table class="volume-table">
          <caption class="price-table__vat">{pricesAsOf} 기준 · {vatLabel} · 확정 금액은 현장 확인 뒤 항목별 견적서로 드립니다.</caption>
          <thead>
            <tr>
              <th scope="col">주거 형태</th>
              {estimator.volume.map((v) => <th scope="col">짐 {v.label.replace('적은 편', '적음').replace('많은 편', '많음')}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              matrix.map((row) => (
                <tr>
                  <th scope="row">
                    <a href={`#cost-${row.key}`}>{row.label}</a>
                  </th>
                  {row.cells.map((cell) => (
                    <td>{cell.range.replace(/만\s*~\s*/, '~')}</td>
                  ))}
                </tr>
              ))
            }
            <tr>
              <th scope="row">
                <a href="#cost-apt30">{housingName('apt30')}</a>
              </th>
              <td colspan={estimator.volume.length}>{apt30.range} · 방문 확인 뒤 확정</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="note">
        짐의 양 기준 — {estimator.volume.map((v) => `${v.label}: ${v.detail}`).join(' / ')}.
      </p>

      {
        sizeAnswers.map((s) => (
          <>
            <h3 id={`cost-${s.key}`}>{sizeHeadings[s.key]}</h3>
            <p>{s.answer}</p>
          </>
        ))
      }

      <EstimateCalc heading="내 조건으로 예상 비용 계산" />

      {/* 산식 한 줄 — '유품정리 비용 계산' 질문의 직답. 항목 이름은 아래 단가표(unitRates)와 같다 */}
      <h2 id="formula">유품정리 비용 계산 방법</h2>
      <p><b>견적 = {formula}</b></p>
      <p>
        {unitName('폐기물 처리 (반 차').note} {unitName('사다리차').note} 각 항목의 단가는 아래 표에 그대로
        공개합니다.
      </p>

      <h2>견적서를 구성하는 단가 <small class="h-note">{vatLabel}</small></h2>
      <p>
        견적서의 합계가 어떻게 나오는지 계산 근거를 그대로 공개합니다. 받아보신 견적서의 각 항목을 아래
        단가와 대조해 보실 수 있습니다.
      </p>
      <div class="table-wrap">
        <table class="price-table">
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">단가</th>
              <th scope="col">설명</th>
            </tr>
          </thead>
          <tbody>
            {
              unitRates.map((row) => (
                <tr>
                  <th scope="row">{row.item}</th>
                  <td>{row.rate}</td>
                  <td>{row.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>견적에 영향을 주는 요소</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">설명</th>
            </tr>
          </thead>
          <tbody>
            {
              factors.map((factor) => (
                <tr>
                  <th scope="row">{factor.name}</th>
                  <td>{factor.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>유품정리 견적서, 비교할 때 확인할 5가지</h2>
      <p>
        여러 업체 견적을 받아 보셨다면 총액보다 먼저 아래 다섯 가지를 맞춰 보세요. 항목이 다르면 총액을
        비교할 수 없습니다.
      </p>
      <ol class="steps">
        {
          compareChecks.map((check) => (
            <li>
              <strong>{check.name}</strong>
              {check.detail}
            </li>
          ))
        }
      </ol>

      <h2>이 가격표는 어떻게 정했나요</h2>
      <p>
        기준 범위는 {marketSurveyedAt}, 가격을 공개한 유품정리 업체들의 가격표와 견적 중개 플랫폼의 공개 거래 통계를
        조사한 뒤 정했습니다. 가격을 공개하지 않는 업체는 조사에서 뺐습니다. 평형별 가격을 공개한 업체들과 비교하면 저희
        범위는 같거나 낮은 쪽에 있습니다(<a href="/#whyus-heading">비교표</a>). 그 범위는 저희 단가 — 폐기물 1톤 차량, 작업 인력 1인, 사다리차
        시간당 금액 — 로 계산되는 금액을 주거 형태별 기준 범위로 정했고, 단가표는 위에 그대로 공개해 두었습니다. 가격을 바꾸면
        기준일({pricesAsOf})을 함께 바꿉니다. 도배·장판 같은 마감 복구는 이 표에 들어 있지 않고 별도 견적이며, 금액은 모두
        {' '}{vatLabel}입니다.
      </p>

      {/*
        '유품정리 견적' 검색어의 정면 답 — 첫 문장에서 무엇을 남기면 무엇을 받는지 바로 말한다.
        회신 시간은 적지 않는다(site.ts responsePromise 주석 — 밤·주말에 지킬 수 없는 약속이 된다).
      */}
      <h2 id="how-to-quote">유품정리 견적 받는 법</h2>
      <p>
        <b>
          상담 폼에 주거 형태·층과 엘리베이터 여부·짐의 양·큰 가전 수·비워야 할 날짜를 남기면 기준표 범위를 먼저
          안내하고, 현장 확인 뒤 항목별 견적서를 드립니다.
        </b>
      </p>
      <ol class="steps">
        <li><strong>상담 접수</strong>주거 형태와 짐의 양을 여쭤보고 대략적인 범위를 안내드립니다.</li>
        <li><strong>현장 확인</strong>방문해 물품 양과 반출 동선을 확인합니다.</li>
        <li><strong>항목별 견적서</strong>작업 항목과 금액을 구분해 서면으로 드립니다.</li>
        <li><strong>확정 · 일정 조율</strong>동의하신 범위 안에서만 작업합니다.</li>
      </ol>

      <h3>알려 주면 범위가 좁혀지는 5가지</h3>
      <ul>
        {
          narrowChecks.map((check) => (
            <li>
              <strong>{check.name}</strong> — {check.detail}
            </li>
          ))
        }
      </ul>
      <p>
        <a href="/consult/">상담 신청 폼에서 견적 받기</a> — 휴대폰 번호만 필수이고, 위 다섯 가지는 상황 칸에 적어 주시면
        됩니다.
      </p>

      <p class="note">
        견적서에 없는 작업은 임의로 진행하지 않습니다. 추가가 필요하면 작업 전에 먼저 확인받습니다.
      </p>

      <CaseGallery
        limit={2}
        heading="이 기준으로 진행한 현장"
        lead="금액은 조건마다 달라 사례에 적지 않습니다. 대신 어디까지 해드리는지는 사진으로 보여드립니다."
        moreLink
      />

      <FAQ items={faqs} />

      {
        costColumns.length > 0 && (
          <>
            <h2>비용을 더 자세히 다룬 칼럼</h2>
            <ul class="link-list">
              {costColumns.map((entry) => (
                <li>
                  <a href={`/column/${entry.id}/`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>함께 보면 좋은 페이지</h2>
      <ul class="link-list">
        <li><a href="/process/">진행 과정</a></li>
        <li><a href="/service/yupumjeongri/">유품정리 서비스</a></li>
        <li><a href="/service/godoksa-yupumjeongri/">고독사 유품정리</a></li>
        <li><a href="/column/">칼럼</a></li>
      </ul>

      <p class="note">최종 수정 <time datetime={updated}>{updated}</time></p>
    </div>
  </section>

  <CTA title="견적부터 받아보세요" body="주거 형태와 짐의 양만 알려주셔도 대략적인 범위를 알려드립니다. 방문 견적도 비용은 발생하지 않습니다." />
</BaseLayout>

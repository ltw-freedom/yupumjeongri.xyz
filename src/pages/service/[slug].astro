---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import { services, type Service } from '../../data/services';
import { regions } from '../../data/areas';
import { servicePhotos, casesByService } from '../../data/cases';
import { serviceSchema, faqSchema } from '../../data/schema';
import PriceTable from '../../components/PriceTable.astro';
import { basePrices, priceAnswer, type PriceRow } from '../../data/pricing';
import { getCollection } from 'astro:content';
import { byNewest } from '../../data/columnLinks';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((item) => item.slug !== service.slug);

const gallery = servicePhotos[service.slug] ?? [];
const serviceKey = service.slug as Parameters<typeof casesByService>[0];
const related = casesByService(serviceKey, 2);
// 해당 서비스 사례가 아직 없으면 제목에 서비스명을 붙이지 않는다 (다른 서비스 사례가 채워진다)
const hasOwnCase = related.some((c) => c.service === serviceKey);
const caseHeading = hasOwnCase ? `${service.name} 진행 사례` : '최근 진행 사례';

/**
 * 유품정리 서비스 페이지에는 주거 형태별 가격표를 싣고, 구조화 데이터(Offer)도 같은 행만 내보낸다.
 * 고독사·빈집 페이지의 서비스별 비용 답은 넣지 않았다 — 담당 지도 초안(2026-10-21, 10/28 결정 예정)에서
 * '고독사 비용'은 온누리, '빈집 비용'은 척척 몫이라 운영자가 '대한 담당 주제만'으로 정했다(2026-10-23).
 */
const priceKeys: PriceRow['key'][] | undefined =
  service.slug === 'yupumjeongri' ? ['oneroom', 'tworoom', 'apt20', 'apt30'] : undefined;
const priceRows = priceKeys ? basePrices.filter((row) => priceKeys.includes(row.key)) : [];

/** 이 서비스를 직접 다룬 칼럼 — 허브에서 칼럼으로 바로 가는 링크(예전엔 /column/ 목록뿐이었다) */
const serviceColumns: Record<string, string[]> = {
  yupumjeongri: ['yupumjeongri-biyong-julineun-beop', 'bumonim-yupumjeongri-jikjeop-biyong', 'gyeonjeokseo-chugageum-hwagin', 'bieoteo-jip-gyeonjeok', 'yupumjeongri-junbi'],
  'godoksa-yupumjeongri': ['godoksa-yupumjeongri-biyong', 'godoksa-hyeonjang-choigi-daeeung'],
  'binjip-jeongri': ['paju-yupumjeongri-pyeonghyeong', 'imdaecha-bojeunggeum-jeongsan'],
};
const columnIds = serviceColumns[service.slug] ?? [];
const columns = (await getCollection('columns', ({ id, data }) => !data.draft && columnIds.includes(id))).sort(byNewest);
---

<BaseLayout
  title={service.title}
  description={service.description}
  jsonLd={[
    serviceSchema({
      name: service.name,
      description: service.description,
      path: `/service/${service.slug}/`,
      serviceType: service.name,
      withPrices: priceKeys,
    }),
    faqSchema(service.faqs),
  ]}
>
  <Breadcrumb items={[{ label: '서비스', href: '/service/' }, { label: service.name }]} />

  <section class="section">
    <div class="container">
      <h1>{service.name}</h1>
      <p class="lead">{service.lead}</p>

      {gallery.length > 0 && <PhotoStrip photos={gallery} compact />}

      <h2>이런 경우에 필요합니다</h2>
      <ul>
        {service.cases.map((item) => <li>{item}</li>)}
      </ul>

      <h2>{service.name} 진행 과정</h2>
      <ol class="steps">
        {
          service.steps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              {step.body}
            </li>
          ))
        }
      </ol>

      <CaseGallery items={related} heading={caseHeading} moreLink />

      {
        priceKeys ? (
          <>
            <h2>{service.name} 비용은 얼마인가요</h2>
            {/* 첫 문장은 비용 질문에 대한 직답 — 검색·AI 발췌용 */}
            <p>
              {priceAnswer()} 평형보다 물품 양, 주거 형태와 층수, 반출 동선, 폐기물 종류가 범위 안의 위치를 정합니다. 견적서를
              구성하는 단가는 <a href="/cost/">비용 안내</a>에 공개해 두었습니다.
            </p>
            <PriceTable rows={priceRows} />
          </>
        ) : (
          <>
            <h2>비용은 어떻게 정해지나요</h2>
            {/* 첫 문장은 비용 질문에 대한 직답 — 검색·AI 발췌용 */}
            <p>
              {priceAnswer()} 물품 양, 주거 형태와 층수, 반출 동선, 폐기물 종류가 기본 요소이고 여기에 특수청소·소독 포함
              여부가 더해집니다. 항목별 기준은 <a href="/cost/">비용 안내</a>에 정리해 두었습니다.
            </p>
          </>
        )
      }

      <FAQ items={service.faqs} />

      {
        columns.length > 0 && (
          <>
            <h2>{service.name} 관련 칼럼</h2>
            <ul class="link-list">
              {columns.map((entry) => (
                <li>
                  <a href={`/column/${entry.id}/`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>지역별 안내</h2>
      <ul class="link-list">
        {
          regions.map((region) => (
            <li>
              <a href={`/area/${region.slug}/`}>{region.name} 지역 안내</a>
            </li>
          ))
        }
      </ul>

      <h2>다른 서비스</h2>
      <ul class="link-list">
        {
          others.map((item) => (
            <li>
              <a href={`/service/${item.slug}/`}>{item.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTA />
</BaseLayout>

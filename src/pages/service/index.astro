---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';
import { localBusiness } from '../../data/schema';
---

<BaseLayout
  title={`서비스 안내 | ${site.name}`}
  description="유품정리, 고독사 유품정리, 빈집 정리 서비스를 안내합니다. 현장 조건에 따라 진행 순서와 포함 범위가 달라집니다."
  jsonLd={[localBusiness()]}
>
  <Breadcrumb items={[{ label: '서비스' }]} />

  <section class="section">
    <div class="container">
      <h1>서비스 안내</h1>
      <p class="lead">
        현장 조건에 따라 필요한 작업이 다릅니다. 어떤 서비스에 해당하는지 애매하다면 상담 시 현장 사진을
        보내주시면 판단해 안내드립니다.
      </p>
      <ul class="grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </ul>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>공통으로 포함되는 것</h2>
      <ul>
        <li>현장 확인 및 항목별 견적 안내</li>
        <li>서류·기록물 분류 후 유가족 전달</li>
        <li>폐기물 종류별 분리 반출</li>
        <li>작업 전후 사진 공유 (원거리 유가족의 경우 필수로 진행)</li>
        <li>반출 후 공간 청소</li>
      </ul>
      <p class="note">
        특수청소·소독, 자재 철거, 도배·장판 등 마감 작업은 현장에 따라 별도 항목으로 안내드립니다.
        자세한 내용은 <a href="/cost/">비용 안내</a>를 확인해 주세요.
      </p>
    </div>
  </section>

  <CTA />
</BaseLayout>

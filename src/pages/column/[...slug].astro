---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getRegion } from '../../data/areas';
import { districtCities } from '../../data/districts';
import { site, absoluteUrl } from '../../data/site';
import { faqSchema, provider } from '../../data/schema';

export async function getStaticPaths() {
  const columns = await getCollection('columns', ({ data }) => !data.draft);
  return columns.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'columns'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// relatedAreas 는 시군구 slug(districts, 56곳 전부) 또는 광역 slug(seoul/gyeonggi)를 받는다.
// 예전엔 큐레이션 8곳(areas.ts)에서만 찾아서 파주·부천·용인 같은 slug 가 조용히 버려졌다.
const linkedAreas = entry.data.relatedAreas.flatMap((slug) => {
  const city = districtCities.find((c) => c.slug === slug);
  if (city) return [{ href: `/area/${city.region}/${city.slug}/`, name: city.name }];
  const region = getRegion(slug);
  if (region) return [{ href: `/area/${region.slug}/`, name: region.name }];
  return [];
});

const pageUrl = absoluteUrl(`/column/${entry.id}/`);

// author·publisher 는 홈의 /#business 노드와 같은 Organization (schema.ts provider()).
// @id 참조만 두면 이 페이지 안에서 노드가 풀리지 않으므로 name·url 을 인라인한 provider() 를 쓴다.
const business = provider();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'ko',
  image: absoluteUrl('/og-image.png'),
  author: business,
  publisher: business,
};

// 화면의 작성·수정 날짜 — 위 Article 스키마와 같은 값(toISOString 의 날짜 부분)이라 둘이 어긋나지 않는다.
// 수정일은 frontmatter updatedAt 이 있을 때만 — 없는 날짜를 만들어 붙이면 가짜 신선도다.
const ymd = (date: Date) => date.toISOString().slice(0, 10);
const published = ymd(entry.data.publishedAt);
const modified = entry.data.updatedAt ? ymd(entry.data.updatedAt) : undefined;
---

<BaseLayout
  title={`${entry.data.title} | ${site.name} 칼럼`}
  description={entry.data.description}
  jsonLd={[articleSchema, ...(entry.data.faq.length > 0 ? [faqSchema(entry.data.faq)] : [])]}
  ogType="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
>
  <Breadcrumb items={[{ label: '칼럼', href: '/column/' }, { label: entry.data.title }]} />

  <article class="section">
    <div class="container">
      <h1>{entry.data.title}</h1>
      <p class="note">{site.name} · 작성 <time datetime={published}>{published}</time>{modified && <span> · 수정 <time datetime={modified}>{modified}</time></span>}</p>

      <Content />

      {/* 금액이 나오는 글에만 붙인다 — 사이트의 모든 표기 금액은 부가세 별도 (pricing.ts) */}
      {entry.body?.includes('만원') && <p class="note">글에 나온 대한유품정리 금액은 모두 부가세(VAT) 별도입니다.</p>}

      <FAQ items={entry.data.faq} />

      {
        linkedAreas.length > 0 && (
          <>
            <h2>관련 지역</h2>
            <ul class="link-list">
              {linkedAreas.map((area) => (
                <li>
                  <a href={area.href}>{area.name} 유품정리</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>함께 보면 좋은 페이지</h2>
      <ul class="link-list">
        <li><a href="/cost/">비용 안내</a></li>
        <li><a href="/process/">진행 과정</a></li>
        <li><a href="/column/">다른 칼럼</a></li>
      </ul>
    </div>
  </article>

  <CTA />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { site } from '../../data/site';
import { faqSchema } from '../../data/schema';

const groups = [
  {
    title: '상담 · 견적',
    items: [
      { q: '상담하면 바로 계약해야 하나요?', a: '아닙니다. 현장 확인과 견적까지 받아보시고 결정하셔도 됩니다.' },
      { q: '방문 견적도 비용이 드나요?', a: '서울·경기 지역은 방문 견적 비용이 발생하지 않습니다.' },
      { q: '주말이나 밤에도 상담이 되나요?', a: '상담 신청은 시간에 관계없이 언제든 접수하실 수 있습니다. 접수되는 즉시 담당자에게 전달되며, 회신은 순차적으로 드립니다. 현장 방문은 일정을 조율해 잡습니다.' },
    ],
  },
  {
    title: '작업 진행',
    items: [
      { q: '유가족이 꼭 현장에 있어야 하나요?', a: '아닙니다. 확인이 필요한 물품은 사진으로 공유해 드리고 처리 여부를 확인받은 뒤 진행합니다.' },
      { q: '작업은 며칠 걸리나요?', a: '일반적인 원룸·아파트는 하루 안에 끝나는 경우가 많습니다. 물품이 많거나 반출 동선이 제한적이면 2일 이상 걸릴 수 있습니다.' },
      { q: '이웃에게 알려지지 않게 진행할 수 있나요?', a: '무표기 차량과 일반 작업복으로 진행하며, 반출 시간대도 협의해 조정합니다.' },
    ],
  },
  {
    title: '고독사 현장',
    items: [
      { q: '냄새가 완전히 없어지나요?', a: '오염이 자재 아래까지 스민 경우 표면 처리만으로는 재발할 수 있습니다. 이 경우 해당 자재를 철거해야 확실히 해결됩니다.' },
      { q: '소독은 몇 번 하나요?', a: '오염 정도에 따라 다릅니다. 1회로 충분한 경우도 있고, 며칠 간격으로 반복해야 하는 경우도 있습니다.' },
      { q: '원상복구까지 해주시나요?', a: '도배·장판 등 마감 작업은 별도 견적으로 안내드립니다.' },
    ],
  },
  {
    title: '비용 · 정산',
    items: [
      { q: '보증금 정산에 쓸 견적서를 받을 수 있나요?', a: '가능합니다. 항목별로 구분해 작성해 드립니다.' },
      { q: '쓸 만한 물건은 비용에서 차감되나요?', a: '재사용·매각 가능한 물품이 있으면 목록으로 안내드리고 협의 후 정산에 반영합니다.' },
    ],
  },
];

const allItems = groups.flatMap((group) => group.items);
---

<BaseLayout
  title={`자주 묻는 질문 | ${site.name}`}
  description="유품정리 상담, 견적, 작업 진행, 고독사 현장, 비용 정산에 대해 자주 받는 질문을 정리했습니다."
  jsonLd={[faqSchema(allItems)]}
>
  <Breadcrumb items={[{ label: 'FAQ' }]} />

  <section class="section">
    <div class="container">
      <h1>자주 묻는 질문</h1>
      <p class="lead">
        여기에 없는 내용은 <a href="/consult/">상담 신청</a>으로 물어보셔도 됩니다. 답변 드리는 데
        비용은 들지 않습니다.
      </p>

      {groups.map((group) => <FAQ title={group.title} items={group.items} />)}
    </div>
  </section>

  <CTA />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { site } from '../../data/site';
import { faqSchema } from '../../data/schema';
import { faqGroups as groups, allFaqItems as allItems } from '../../data/faqs';
---

<BaseLayout
  title={`자주 묻는 질문 | ${site.name}`}
  description="유품정리 상담, 견적, 작업 진행, 고독사 현장, 비용 정산에 대해 자주 받는 질문을 정리했습니다."
  jsonLd={[faqSchema(allItems)]}
>
  <Breadcrumb items={[{ label: 'FAQ' }]} />

  <section class="section">
    <div class="container">
      <h1>자주 묻는 질문</h1>
      <p class="lead">
        여기에 없는 내용은 <a href="/consult/">상담 신청</a>으로 물어보셔도 됩니다. 답변 드리는 데
        비용은 들지 않습니다.
      </p>

      {groups.map((group) => <FAQ title={group.title} items={group.items} />)}
    </div>
  </section>

  <CTA />
</BaseLayout>

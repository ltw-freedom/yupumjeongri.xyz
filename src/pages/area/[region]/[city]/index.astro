---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import CTA from '../../../../components/CTA.astro';
import FAQ from '../../../../components/FAQ.astro';
import PriceTable from '../../../../components/PriceTable.astro';
import CaseGallery from '../../../../components/CaseGallery.astro';
import AreaQuick from '../../../../components/AreaQuick.astro';
import EstimateCalc from '../../../../components/EstimateCalc.astro';
import { getRegion, cityShortName } from '../../../../data/areas';
import { districtCities, type DistrictCity } from '../../../../data/districts';
import { nearbyDistricts } from '../../../../data/adjacency';
import { getAliases } from '../../../../data/dongAliases';
import { cityLead, cityFaqs } from '../../../../data/districtContent';
import { services } from '../../../../data/services';
import { site } from '../../../../data/site';
import { casesFor } from '../../../../data/cases';
import { serviceSchema, faqSchema } from '../../../../data/schema';
import { priceAnswer } from '../../../../data/pricing';
import { getCollection } from 'astro:content';

/**
 * 시·군·구 페이지 — 두 티어를 한 라우트에서 처리한다.
 *  - 큐레이션 티어(areas.ts): 손으로 쓴 지역 특징·비용 요소·FAQ 가 있는 지역
 *  - 생성 티어(districts.ts): 법정동 데이터 기반 템플릿 페이지
 * 두 티어 모두 법정동 링크 그리드를 노출한다 — 동 페이지가 키워드 표면이다.
 */
export function getStaticPaths() {
  return districtCities.map((dc) => ({
    params: { region: dc.region, city: dc.slug },
    props: { dc },
  }));
}

interface Props {
  dc: DistrictCity;
}

const { dc } = Astro.props;
const region = getRegion(dc.region)!;
const curated = region.cities.find((c) => c.slug === dc.slug);
const aliases = getAliases(dc.region, dc.slug);
const short = cityShortName(dc);
/** 빠른 상담 폼이 Slack 에 함께 넘기는 지역 (예: '서울 마포구') */
const regionHint = `${region.name} ${dc.name}`;

// 인접 시·군·구 — 실제 지리·생활권 기준(adjacency.ts). 광역이 달라도(노원 ↔ 의정부) 이어 준다.
const nearby = nearbyDistricts(dc.slug, 4);

// 이 지역과 연결된 칼럼 (frontmatter 의 relatedAreas 로 연결)
const columns = await getCollection('columns', ({ data }) => !data.draft);
const relatedColumns = columns
  .filter((entry) => entry.data.relatedAreas.includes(dc.slug) || entry.data.relatedAreas.includes(dc.region))
  .slice(0, 3);

const faqs = curated?.faqs ?? cityFaqs(dc, { nearby, aliases });

// 같은 시·군·구 사례가 있으면 앞에, 없으면 같은 광역 사례로 채운다
const localCases = casesFor(dc.region, dc.slug, 2);
const hasLocalCase = localCases.some((c) => c.city === dc.slug);

// 링크 가치를 위쪽에 몰아준다 — 본문에는 앞 12개만, 나머지는 접어 둔다
const visibleDongs = dc.dongs.slice(0, 12);
const foldedDongs = dc.dongs.slice(12);
const summary = curated?.summary ?? `${dc.name} 전 지역 유품정리·고독사 특수청소·빈집 정리.`;

// 네이버 순위의 핵심 요인 — 패턴을 바꾸기 전에 docs/seo-naver.md 를 읽을 것
const title = `${dc.name}유품정리 · ${short} 유품정리 비용·견적 | ${site.name}`;
// 네이버 서치어드바이저 권고: 설명문 80자 이내
const description = `${short}유품정리 업체 — ${summary} 비용 공개·추가금 0원·방문 견적.`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    serviceSchema({
      name: `${dc.name} 유품정리`,
      description: summary,
      path: `/area/${dc.region}/${dc.slug}/`,
      areaServed: [dc.name],
      // 아래 본문에 PriceTable 을 그대로 싣는다 — 표에 있는 금액이므로 Offer 로 내보낸다
      withPrices: true,
    }),
    faqSchema(faqs),
  ]}
>
  <Breadcrumb
    items={[
      { label: '지역', href: '/area/' },
      { label: region.name, href: `/area/${dc.region}/` },
      { label: dc.name },
    ]}
  />

  <section class="section">
    <div class="container">
      <h1>{dc.name} 유품정리</h1>
      <p class="lead">{curated ? curated.summary : cityLead(dc)}</p>

      <AreaQuick name={dc.name} regionHint={regionHint} />

      {
        curated && (
          <>
            <h2>{dc.name} 현장의 특징</h2>
            <ul>
              {curated.traits.map((trait) => (
                <li>{trait}</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>{dc.name} 유품정리 비용</h2>
      {/* 첫 문장은 "○○ 유품정리 비용"에 대한 직답 — 검색·AI 발췌용 (pricing.ts 의 priceAnswer) */}
      <p>
        {priceAnswer(`${dc.name} 유품정리 비용`)} 지역과 무관하게 같은 기준을 적용하며, 범위가 달라지는 것은
        물품 양, 반출 동선, 특수청소 여부뿐입니다.
      </p>
      <PriceTable />
      <p class="note"><a href="/cost/">비용 산정 기준 전체 보기</a></p>

      <EstimateCalc heading={`${short} 우리 집 예상 비용 계산`} regionHint={regionHint} />

      {
        curated && (
          <>
            <h2>{dc.name} 유품정리 비용에 영향을 주는 요소</h2>
            <ul>
              {curated.costFactors.map((factor) => (
                <li>{factor}</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>{dc.name} 법정동별 유품정리 안내</h2>
      <p>{dc.name}의 모든 법정동에서 진행합니다. 해당 지역을 선택하면 상세 안내를 볼 수 있습니다.</p>
      <ul class="link-list">
        {
          aliases.map((alias) => (
            <li>
              <a href={`/area/${dc.region}/${dc.slug}/${alias.slug}/`}>
                {alias.name} 유품정리
              </a>
            </li>
          ))
        }
        {
          visibleDongs.map((dong) => (
            <li>
              <a href={`/area/${dc.region}/${dc.slug}/${dong.slug}/`}>{dong.name} 유품정리</a>
            </li>
          ))
        }
      </ul>
      {
        foldedDongs.length > 0 && (
          <details>
            <summary>나머지 {foldedDongs.length}개 지역 보기</summary>
            <ul class="link-list">
              {foldedDongs.map((dong) => (
                <li>
                  <a href={`/area/${dc.region}/${dc.slug}/${dong.slug}/`}>{dong.name} 유품정리</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {/*
        서비스·진행 과정·'왜 대한유품정리인가'는 56개 시군구에 똑같이 들어가는 글이라 링크로만 둔다.
        2026-10-06 네이버에서 시군구 페이지 상당수가 제목 검색으로도 안 나왔다 — 본문의 65~88%가
        페이지끼리 같아 유사문서로 묶인 것으로 판단 (docs/seo-naver.md 4-2). 공통 블록을 본문에 다시 늘리지 말 것.
      */}
      <h2>{dc.name}에서 제공하는 서비스</h2>
      <ul class="link-list">
        {
          services.map((service) => (
            <li>
              <a href={`/service/${service.slug}/`}>{service.name}</a>
            </li>
          ))
        }
      </ul>
      <p>
        <a href="/process/">진행 과정 5단계</a> · <a href="/#whyus-heading">다른 업체와 무엇이 다른가</a>
      </p>

      <CaseGallery
        items={localCases}
        heading={hasLocalCase ? `${dc.name} 진행 사례` : `${region.name} 인근 진행 사례`}
        moreLink
      />

      <FAQ title={`${dc.name} 유품정리 자주 묻는 질문`} items={faqs} />

      {
        relatedColumns.length > 0 && (
          <>
            <h2>관련 칼럼</h2>
            <ul class="link-list">
              {relatedColumns.map((entry) => (
                <li>
                  <a href={`/column/${entry.id}/`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        nearby.length > 0 && (
          <>
            <h2>인근 지역</h2>
            <ul class="link-list">
              {nearby.map((item) => (
                <li>
                  <a href={`/area/${item.region}/${item.slug}/`}>{item.name} 유품정리</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <CTA title={`${dc.name} 유품정리 상담`} body="주거 형태와 짐의 양만 알려주셔도 대략적인 범위와 비용을 안내드립니다." regionHint={regionHint} />
</BaseLayout>

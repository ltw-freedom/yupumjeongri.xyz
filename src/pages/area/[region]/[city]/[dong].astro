---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import CTA from '../../../../components/CTA.astro';
import FAQ from '../../../../components/FAQ.astro';
import PriceTable from '../../../../components/PriceTable.astro';
import PhotoStrip from '../../../../components/PhotoStrip.astro';
import AreaQuick from '../../../../components/AreaQuick.astro';
import EstimateCalc from '../../../../components/EstimateCalc.astro';
import DongHousingChart from '../../../../components/DongHousingChart.astro';
import DongEstimateExample from '../../../../components/DongEstimateExample.astro';
import { getRegion } from '../../../../data/areas';
import { districtCities, nearbyDongs, type DistrictCity, type DistrictDong } from '../../../../data/districts';
import { dongAliases, type DongAlias } from '../../../../data/dongAliases';
import { dongDisplayName, dongShortName, dongLead, dongCostNote, dongFaqs } from '../../../../data/districtContent';
import { services } from '../../../../data/services';
import { site } from '../../../../data/site';
import { photos } from '../../../../data/cases';
import { serviceSchema, faqSchema, place } from '../../../../data/schema';
import { priceAnswer } from '../../../../data/pricing';
import { getCollection } from 'astro:content';
import { relatedColumnsFor } from '../../../../data/columnLinks';
import { matchAdminDongs, dongHousingSentences, dongEstimateExample, dongHousingFallback } from '../../../../data/dongHousing';
import { cityStatsBlock } from '../../../../data/cityStatsContent';
import { casesFor } from '../../../../data/dongCases';

/**
 * 법정동 페이지 — 지역 키워드 노출의 최전선.
 * 법정동 1,200여 곳 + 신도시 별칭(위례·동탄·광교 등)을 같은 템플릿으로 만든다.
 * 지어낸 지역 정보는 넣지 않고, 공개 가격 + 서비스 사실 + 내부 링크로 구성한다.
 * 동마다 다른 내용은 '주거 형태와 예상 견적' 블록(2025 인구주택총조사 행정동 주택 구성 + 예시 계산)이 맡는다
 * — dongHousing.ts. 지어낸 작업 사례·후기는 넣지 않는다. 실제 작업 기록은 dongCases.ts(운영자 확인분)만.
 */
export function getStaticPaths() {
  const dongPaths = districtCities.flatMap((dc) =>
    dc.dongs.map((dong) => ({
      params: { region: dc.region, city: dc.slug, dong: dong.slug },
      props: { dc, dong, alias: null },
    })),
  );
  const aliasPaths = dongAliases.map((alias) => {
    const dc = districtCities.find((c) => c.region === alias.region && c.slug === alias.citySlug)!;
    return {
      params: { region: alias.region, city: alias.citySlug, dong: alias.slug },
      props: { dc, dong: null, alias },
    };
  });
  return [...dongPaths, ...aliasPaths];
}

interface Props {
  dc: DistrictCity;
  dong: DistrictDong | null;
  alias: DongAlias | null;
}

const { dc, dong, alias } = Astro.props;
const region = getRegion(dc.region)!;
const unit = (dong ?? alias)!;
const display = dongDisplayName(dc, unit);
const short = dongShortName(unit.name);
/** 빠른 상담 폼이 Slack 에 함께 넘기는 지역 (예: '서울 송파구 잠실동') */
const regionHint = `${region.name} ${dc.name} ${unit.name}`;

// 별칭(신도시) 페이지는 생활권을 구성하는 법정동 페이지로 링크한다
const legalLinks = alias
  ? dc.dongs.filter((d) => alias.legalDongs.includes(d.name))
  : [];
const nearby = dong ? nearbyDongs(dc, dong.slug, 8) : dc.dongs.slice(0, 8);

const columns = await getCollection('columns', ({ data }) => !data.draft);
const relatedColumns = relatedColumnsFor(columns, dc.slug, dc.region);

const faqs = dongFaqs(dc, unit);

// 주거 형태 블록 — 2025 인구주택총조사(행정동) + 공개 가격표로 동마다 다른 실데이터를 싣는다 (dongHousing.ts)
// 행정동을 이름으로 잇지 못한 페이지는 시군구 숫자를 이 동의 구성처럼 보이지 않게 블록 대신 한 줄 안내만 둔다
const housing = matchAdminDongs(dc, unit);
const housingSentences = housing.source === 'dong' ? dongHousingSentences(dc, unit, housing) : [];
const example = housing.source === 'dong' ? dongEstimateExample(unit, housing) : null;
const cityStatsHref = cityStatsBlock(dc) ? `/area/${dc.region}/${dc.slug}/#city-stats-heading` : null;
// 운영자가 확인한 실제 작업 기록만 (dongCases.ts). 없으면 절을 그리지 않는다
const cases = casesFor(dc.region, dc.slug, unit.slug);

/**
 * 현장 사진 띠 — 실제 현장 사진 가운데 3장을 동 slug 해시로 결정적으로 고른다(같은 시군구 동 페이지끼리 같은 캡션이
 * 반복되지 않게). 캡션은 원래 사진의 '무슨 작업 · 어디' 그대로라 이 동의 현장처럼 읽히지 않는다.
 * 특수청소·빈집 사진은 넣지 않는다(이 페이지 본문에서 새로 다루지 않는 주제).
 */
const photoPool = [
  photos.teamLoadingTruck,
  photos.sortedBagsGuitar,
  photos.kitchenAfter,
  photos.teamCrate,
  photos.loadingBagsSunny,
  photos.heroLadderTruck,
  photos.balconyHighrise,
  photos.livingBefore,
  photos.roomBeforeBed,
  photos.curtainRail,
];
function seedHash(seed: string): number {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
  return h;
}
const stripPhotos = (() => {
  const pool = [...photoPool];
  const out = [];
  let h = seedHash(`photo:${dc.slug}:${unit.slug}`);
  for (let k = 0; k < 3; k++) {
    out.push(pool.splice(h % pool.length, 1)[0]);
    h = Math.floor(h / 7) + 13;
  }
  return out;
})();
/** 구조화 데이터용 상위 행정구역 (성남시 > 분당구 > 정자동처럼 일반구가 있으면 중간에 넣는다) */
const cityPlace = { name: dc.name, city: dc.name.endsWith('시'), parent: { name: region.name } };

// 지역명을 3중으로 쌓지 않는다 ("송파구 잠실동 유품정리 · 잠실 유품정리 …" ×) —
// 클릭률이 떨어진다. 짧은 지역명 변형("잠실유품정리")은 description 이 받는다.
const title = `${display} 유품정리 비용·견적 | ${site.name}`;
// 네이버 서치어드바이저 권고: 설명문 80자 이내
const description = `${short}유품정리 업체 — ${display} 유품정리·고독사 특수청소·빈집 정리. 비용 공개·추가금 0원·방문 견적.`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    serviceSchema({
      name: `${display} 유품정리`,
      description: `${display} 유품정리 · 고독사 특수청소 · 빈집 정리. 방문 견적 진행.`,
      path: `/area/${dc.region}/${dc.slug}/${unit.slug}/`,
      areaServed: [
        place({
          name: unit.name,
          parent: unit.gu ? { name: unit.gu, parent: cityPlace } : cityPlace,
        }),
      ],
      // 아래 본문에 PriceTable 을 그대로 싣는다 — 표에 있는 금액이므로 Offer 로 내보낸다
      withPrices: true,
    }),
    faqSchema(faqs),
  ]}
>
  <Breadcrumb
    items={[
      { label: '지역', href: '/area/' },
      { label: region.name, href: `/area/${dc.region}/` },
      { label: dc.name, href: `/area/${dc.region}/${dc.slug}/` },
      { label: unit.name },
    ]}
  />

  <section class="section">
    <div class="container">
      <h1>{display} 유품정리</h1>
      <p class="lead">{alias ? alias.intro : dongLead(dc, unit)}</p>

      <AreaQuick name={display} regionHint={regionHint} />

      <h2>{display} 유품정리 비용</h2>
      {/* 첫 문장은 "○○동 유품정리 비용"에 대한 직답 — 검색·AI 발췌용 */}
      <p>{priceAnswer(`${display} 유품정리 비용`)} {dongCostNote(dc, unit)}</p>
      <PriceTable />
      <p class="note">
        확정 금액은 현장 확인 후 항목별 견적서로 드립니다. {site.guaranteeShort}
        <a href="/cost/">비용 산정 기준과 단가 전체 보기</a>
      </p>

      <EstimateCalc heading={`${short} 우리 집 예상 비용 계산`} regionHint={regionHint} />

      <div class="dong-housing" data-housing-source={housing.source}>
        {
          housing.source === 'dong' && example ? (
            <>
              <h2>{display} 주거 형태와 예상 견적</h2>
              <p>
                {housingSentences.map((sentence, i) => (
                  <>
                    {i > 0 && ' '}
                    {sentence.text}
                    {sentence.link && (
                      <>
                        {' ('}<a href={sentence.link.href}>{sentence.link.label}</a>{')'}
                      </>
                    )}
                  </>
                ))}
              </p>
              <DongHousingChart dc={dc} unit={unit} h={housing} />
              <DongEstimateExample example={example} />
            </>
          ) : (
            <p class="note">
              {dongHousingFallback(unit)}
              {cityStatsHref && (
                <>
                  {' '}<a href={cityStatsHref}>{dc.name} 주택·가구 통계 보기</a>
                </>
              )}
            </p>
          )
        }
      </div>

      {
        cases.length > 0 && (
          <>
            <h2>{unit.name} 실제 작업 기록</h2>
            <p class="note">운영자가 확인한 실제 작업만 싣습니다.</p>
            <ul class="link-list">
              {cases.map((c) => (
                <li>
                  {c.date} · {c.housing} · {c.priceRange} — {c.summary}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        legalLinks.length > 0 && (
          <>
            <h2>{unit.name} 생활권의 법정동</h2>
            <p>{display} 일대는 아래 법정동으로 구성됩니다. 주소지 기준 안내는 각 페이지에서 확인하세요.</p>
            <ul class="link-list">
              {legalLinks.map((d) => (
                <li>
                  <a href={`/area/${dc.region}/${dc.slug}/${d.slug}/`}>{d.name} 유품정리</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {/* 모든 동 페이지에 똑같이 깔리던 서비스 카드·5단계 목록은 유사문서 원인이라 링크 한 줄로 줄였다 (2026-11-08) */}
      <p class="dong-links">
        서비스:{' '}
        {services.map((service, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`/service/${service.slug}/`}>{service.name}</a>
          </>
        ))}
        {' · '}
        <a href="/process/">진행 과정</a>
      </p>

      <PhotoStrip
        photos={stripPhotos}
        heading="직접 진행한 현장"
        compact
      />

      <FAQ title={`${display} 유품정리 자주 묻는 질문`} items={faqs} />

      {
        relatedColumns.length > 0 && (
          <>
            <h2>관련 칼럼</h2>
            <ul class="link-list">
              {relatedColumns.map((entry) => (
                <li>
                  <a href={`/column/${entry.id}/`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        nearby.length > 0 && (
          <>
            <h2>{dc.name} 인근 지역</h2>
            <ul class="link-list">
              {nearby.map((item) => (
                <li>
                  <a href={`/area/${dc.region}/${dc.slug}/${item.slug}/`}>{item.name} 유품정리</a>
                </li>
              ))}
              <li>
                <a href={`/area/${dc.region}/${dc.slug}/`}>{dc.name} 전체 보기</a>
              </li>
            </ul>
          </>
        )
      }
    </div>
  </section>

  <CTA title={`${display} 유품정리 상담`} body="주거 형태와 짐의 양만 알려주셔도 대략적인 범위와 비용을 안내드립니다." regionHint={regionHint} />
</BaseLayout>

<style is:global>
  .dong-links {
    margin-top: 2rem;
    font-size: 0.95rem;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import { getEntry } from 'astro:content';
import { site } from '../../data/site';
import { photos } from '../../data/cases';
import { faqSchema, webPage } from '../../data/schema';
import { contentDate } from '../../data/contentDates';
import { processSteps, processAnswer, prepItems, processFaqs } from '../../data/process';

/** 단계별 실제 장면 — 현장 확인 → 분류·선별 → 반출 → 청소 */
const stepPhotos = [
  { ...photos.livingBefore, caption: '현장 확인 · 하남 덕풍동' },
  { ...photos.sortedBagsGuitar, caption: '분류 · 보관품 선별 · 남양주' },
  { ...photos.loadingBagsSunny, caption: '반출 · 도봉구' },
  { ...photos.kitchenAfter, caption: '청소 · 마무리 · 광진구' },
];

/**
 * 업체를 부르기 전 준비는 칼럼이 맡는다 — 사망 후 행정 절차는 이 페이지에서 다루지 않고(다른 브랜드 몫)
 * 준비 칼럼으로만 잇는다. 칼럼이 내려가거나 초안이면 링크도 빠진다.
 */
const prepColumn = await getEntry('columns', 'yupumjeongri-junbi');
const prepLink = prepColumn && !prepColumn.data.draft ? { href: `/column/${prepColumn.id}/`, title: prepColumn.data.title } : undefined;

// 실제로 본문을 고친 날 — contentDates.ts 수동 지도. 스키마 dateModified 와 하단 '최종 수정' 줄이 같은 값을 쓴다.
const updated = contentDate('/process/');
---

<BaseLayout
  title={`유품정리 절차 | 상담부터 마무리 확인까지 ${processSteps.length}단계 - ${site.name}`}
  description={`유품정리 절차는 상담부터 현장 확인, 견적, 유품 분류, 보관품 선별, 폐기 반출, 청소, 마무리 확인까지 ${processSteps.length}단계입니다. 단계마다 유가족이 정할 것과 비용이 정해지는 지점, 걸리는 기간을 정리했습니다.`}
  jsonLd={[faqSchema(processFaqs), webPage({ path: '/process/', name: '유품정리 절차', dateModified: updated })]}
>
  <Breadcrumb items={[{ label: '진행과정' }]} />

  <section class="section">
    <div class="container">
      <h1>유품정리 절차</h1>
      {/* 첫 문단은 '유품정리 절차·순서' 질문에 대한 직답 — 검색·AI 발췌용 (process.ts) */}
      <p class="lead">{processAnswer}</p>
      <p>
        어느 단계에서 유가족의 결정이 필요한지 미리 알아두시면 준비가 수월합니다. 단계마다 유가족이 정할 것과,
        비용이 정해지는 단계에는 그 기준을 함께 적었습니다.
      </p>

      <ol class="steps">
        {
          processSteps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              {step.body}
              <p class="step-note">
                <span class="step-note__label">유가족이 정할 것</span>
                {step.decide}
              </p>
              {step.cost && (
                <p class="step-note">
                  <span class="step-note__label">비용</span>
                  {step.cost} <a href="/cost/">비용 안내 보기</a>
                </p>
              )}
            </li>
          ))
        }
      </ol>

      <PhotoStrip photos={stepPhotos} heading="단계별 현장 모습" compact />

      <CaseGallery
        limit={2}
        heading="마무리 확인 단계에서 드리는 사진"
        lead="작업 전후를 같은 자리에서 찍어 공유합니다. 원거리 유가족도 이 사진으로 확인하십니다."
        moreLink
      />

      <h2>유가족이 준비하면 좋은 것</h2>
      <ul>
        {prepItems.map((item) => <li>{item}</li>)}
      </ul>

      <FAQ title="유품정리 절차 자주 묻는 질문" items={processFaqs} />

      <h2>함께 보면 좋은 페이지</h2>
      <ul class="link-list">
        <li><a href="/cost/">비용 안내</a></li>
        <li><a href="/service/yupumjeongri/">유품정리 서비스</a></li>
        {prepLink && <li><a href={prepLink.href}>{prepLink.title}</a></li>}
        <li><a href="/faq/">자주 묻는 질문</a></li>
      </ul>

      <p class="note">최종 수정 <time datetime={updated}>{updated}</time></p>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  /* 단계 본문 아래 보조 줄 — 본문보다 한 단계 작게, 라벨만 금색으로 구분한다 */
  .step-note {
    margin: 0.45rem 0 0;
    font-size: 0.94rem;
    color: var(--color-muted);
  }

  .step-note__label {
    display: inline-block;
    margin-right: 0.4rem;
    font-weight: 700;
    color: var(--color-gold);
  }
</style>

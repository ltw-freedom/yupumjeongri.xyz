---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { regions } from '../data/areas';
import { localBusiness, faqSchema } from '../data/schema';

const faqs = [
  {
    q: '상담하면 바로 계약해야 하나요?',
    a: '아닙니다. 현장 확인과 견적 안내까지 받아보시고 결정하셔도 됩니다.',
  },
  {
    q: '견적은 어떻게 산정되나요?',
    a: '물품 양, 주거 형태와 층수, 반출 동선, 폐기물 종류, 특수청소 포함 여부에 따라 달라집니다. 항목별로 나눠 안내드립니다.',
  },
  {
    q: '어느 지역까지 가나요?',
    a: '서울과 경기 전 지역에서 진행합니다. 그 외 지역도 일정에 따라 가능하니 상담 시 문의해 주세요.',
  },
];
---

<BaseLayout
  title={site.title}
  description={site.description}
  jsonLd={[localBusiness(), faqSchema(faqs)]}
>
  <Hero
    title="남겨진 물건을 정중하게 정리합니다"
    lead="유품정리, 고독사 현장 정리, 빈집 정리. 현장 확인부터 유품 분류와 보관품 선별, 폐기, 공간 정돈까지 한 번에 진행합니다."
  />

  <section class="section section--surface">
    <div class="container">
      <h2>서비스</h2>
      <ul class="grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>진행 과정</h2>
      <ol class="steps">
        <li><strong>상담 · 현장 확인</strong>물품 양과 반출 동선을 확인하고 일정과 비용을 안내드립니다.</li>
        <li><strong>유품 분류</strong>귀중품, 서류, 사진·기록물, 일반 물품으로 나눠 분류합니다.</li>
        <li><strong>보관품 선별</strong>전달해 드릴 물건을 따로 모아 포장합니다.</li>
        <li><strong>폐기 · 반출</strong>폐기물은 종류별로 분리해 규정에 맞춰 처리합니다.</li>
        <li><strong>공간 정돈</strong>반출 후 청소까지 마무리합니다.</li>
      </ol>
      <p><a href="/process/">진행 과정 자세히 보기</a></p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>서비스 지역</h2>
      {
        regions.map((region) => (
          <>
            <h3>
              <a href={`/area/${region.slug}/`}>{region.name}</a>
            </h3>
            <ul class="link-list">
              {region.cities.map((city) => (
                <li>
                  <a href={`/area/${region.slug}/${city.slug}/`}>{city.name} 유품정리</a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FAQ items={faqs} />
    </div>
  </section>

  <CTA />
</BaseLayout>

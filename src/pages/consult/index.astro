---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import FormHidden from '../../components/FormHidden.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';
import { photos } from '../../data/cases';
import { estimator } from '../../data/pricing';

/**
 * 정적 페이지 + Cloudflare Worker(POST /api/consult) 조합.
 * JS 없이도 동작하도록 일반 form POST 로 두고, 결과는 서버가 303 리다이렉트로 알려준다.
 * 필수 항목은 휴대폰 번호 하나뿐이다 — 입력 부담을 최소로 둔다.
 *
 * 모바일 기준 배치 원칙: 이 페이지에 온 사람은 이미 신청하기로 마음먹은 사람이다.
 * 설명을 먼저 읽히지 말고 번호 칸을 첫 화면에 둔다. 믿을 근거는 폼 아래로 내린다.
 * 선택 항목은 타이핑 대신 눌러서 고르게 한다(주거 형태·서비스).
 */
const errors: Record<string, string> = {
  required: '휴대폰 번호를 입력해 주세요.',
  phone: '휴대폰 번호 형식을 확인해 주세요. (예: 010-1234-5678)',
  send: '전송 중 문제가 생겼습니다. 입력하신 내용은 그대로 두었으니 잠시 후 다시 보내 주세요.',
  form: '입력 내용을 읽지 못했습니다. 다시 시도해 주세요.',
  config: '접수 시스템 점검 중입니다. 잠시 후 다시 시도해 주세요.',
};

const recentPhotos = [photos.teamLoadingTruck, photos.sortedBagsGuitar, photos.kitchenAfter];
const housingOptions = [...estimator.housing.map((h) => h.label), '잘 모르겠음'];
---

<BaseLayout
  title={`상담 신청 | ${site.name}`}
  description="유품정리 상담 신청. 휴대폰 번호만 남겨주시면 비용 범위와 진행 방법을 안내드립니다. 계약 의무 없음."
>
  <Breadcrumb items={[{ label: '상담 신청' }]} />

  <section class="section consult">
    <div class="container container--narrow">
      <h1>유품정리 상담 신청</h1>
      <p class="consult__lead">
        휴대폰 번호 하나면 됩니다. <b>{site.responsePromise}.</b>
      </p>
      <ul class="consult__chips" aria-label="약속">
        <li>계약 의무 없음</li>
        <li>광고 문자 없음</li>
        <li>견적서 외 추가금 0원</li>
      </ul>

      {/* 서버가 ?error= 로 되돌려 보낸 경우에만 보이는 안내. */}
      <div id="form-error" class="form-error" role="alert" hidden></div>

      <form class="form" method="POST" action="/api/consult" data-consult>
        <div class="field field--phone">
          <label for="phone">연락받으실 휴대폰 번호 <span class="req">필수</span></label>
          {/*
            pattern: 숫자 클래스는 [0-9] 로 쓴다 — 역슬래시 d 는 Astro 가 속성값에서 삼킨다.
            하이픈이 든 문자 클래스는 브라우저가 pattern 을 v 플래그로 컴파일할 때 깨진다.
            둘 다 "패턴이 통째로 무시"되는 결과라 구분자는 (-| ) 로 적는다.
            어차피 진짜 방어선은 서버(normalizePhone)다.
          */}
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            maxlength="20"
            inputmode="tel"
            autocomplete="tel"
            pattern="01[016789](-| )?[0-9]{3,4}(-| )?[0-9]{4}"
            title="01로 시작하는 휴대폰 번호를 입력해 주세요. 예: 010-1234-5678"
            placeholder="010-1234-5678"
          />
          <p class="quick-consult__error" data-phone-error role="alert" hidden></p>
          <p class="hint">
            이 번호로 문자 또는 전화를 드립니다. 처음 보는 번호로 연락이 가더라도 {site.name}입니다.
          </p>
        </div>

        {/*
          번호만 남기고 바로 보내려는 사람을 위해 버튼을 번호 칸 바로 아래에 둔다.
          아래 선택 항목을 채운 사람은 맨 아래 버튼을 누른다 — 두 버튼 모두 같은 폼 전체를 보낸다.
        */}
        <button class="button button--primary" type="submit">상담 신청</button>

        <p class="form__optional">
          <b>선택</b> 아래를 알려주시면 첫 연락에서 비용 범위까지 말씀드릴 수 있습니다.
        </p>

        <fieldset class="chips-field">
          <legend>주거 형태</legend>
          <div class="chips chips--compact">
            {
              housingOptions.map((label) => (
                <label class="chip">
                  <input type="radio" name="housing" value={label} />
                  <span>{label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="chips-field">
          <legend>필요한 서비스</legend>
          <div class="chips chips--compact">
            {
              [...services.map((service) => service.name), '잘 모르겠음'].map((label) => (
                <label class="chip">
                  <input type="radio" name="type" value={label} />
                  <span>{label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="region">지역</label>
          <input
            id="region"
            name="region"
            type="text"
            maxlength="60"
            autocomplete="off"
            placeholder="예: 서울 관악구, 성남시 분당구"
          />
        </div>

        <div class="field">
          <label for="message">상황 (자유롭게)</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            maxlength="2000"
            placeholder="예: 3층 빌라, 엘리베이터 없음. 다음 달 말까지 집을 비워야 합니다."
          ></textarea>
        </div>

        <FormHidden id="consult" />

        <button class="button button--primary" type="submit">상담 신청</button>

        {/* 별도 동의 절차는 두지 않는다. 상담 회신에 필요한 최소 항목만 받고 고지로 갈음한다. */}
        <p class="hint">
          받는 정보는 {site.privacy.items}뿐입니다. {site.privacy.purpose} 목적으로만 쓰고{' '}
          {site.privacy.retention} 파기합니다.
        </p>
      </form>

      <div class="consult-why">
        <h2>번호를 남기시면 이렇게 됩니다</h2>
        <ul>
          <li>최대한 빠르게 사람이 직접 연락합니다. 자동 응답도, 영업 콜센터도 아닙니다.</li>
          <li>첫 연락에서 비용 범위를 숫자로 말씀드립니다. "현장을 봐야 안다"로 끝내지 않습니다.</li>
          <li>견적서 외 추가금 0원. 동일 조건 타사 견적서가 있으면 그보다 낮게 진행합니다.</li>
          <li>계약 의무가 없고, 번호는 회신에만 쓰고 상담이 끝나면 바로 파기합니다. 광고 문자는 없습니다.</li>
        </ul>
      </div>

      <h2>접수 이후</h2>
      <ol class="steps">
        <li><strong>연락</strong>남겨주신 번호로 최대한 빠르게 연락드려 상황을 확인합니다.</li>
        <li><strong>비용 범위 안내</strong>주거 형태와 짐의 양을 여쭤보고 범위를 좁혀 안내드립니다.</li>
        <li><strong>현장 확인</strong>방문해 물품 양과 반출 동선을 확인합니다. 방문 비용은 없습니다.</li>
        <li><strong>항목별 견적서</strong>작업 항목과 금액을 구분해 서면으로 드립니다. 이때 결정하시면 됩니다.</li>
      </ol>

      <p class="note">
        견적서에 없는 작업은 임의로 진행하지 않습니다. {site.guaranteeShort}
        비용 기준은 <a href="/cost/">비용 페이지</a>에 전부 공개되어 있습니다.
      </p>

      <PhotoStrip photos={recentPhotos} heading="최근 진행한 현장" compact />
    </div>
  </section>

  <script is:inline define:vars={{ errors }}>
    // 서버가 붙여 보낸 ?error= 코드를 사람이 읽을 문장으로 바꾼다.
    // 입력 내용 복원은 공통 스크립트(src/scripts/consult-form.ts)가 한다.
    const code = new URLSearchParams(location.search).get('error');
    const box = document.getElementById('form-error');
    if (code && box) {
      box.textContent = errors[code] ?? errors.send;
      box.hidden = false;
      box.scrollIntoView({ block: 'center' });
    }
  </script>
</BaseLayout>

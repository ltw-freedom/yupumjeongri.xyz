---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';

/**
 * 정적 페이지 + Cloudflare Pages Function(POST /api/consult) 조합.
 * JS 없이도 동작하도록 일반 form POST 로 두고, 결과는 서버가 303 리다이렉트로 알려준다.
 */
const errors: Record<string, string> = {
  required: '닉네임과 휴대폰 번호는 반드시 입력해 주세요.',
  phone: '휴대폰 번호 형식을 확인해 주세요. (예: 010-1234-5678)',
  send: '전송 중 문제가 생겼습니다. 잠시 후 다시 시도해 주세요.',
  form: '입력 내용을 읽지 못했습니다. 다시 시도해 주세요.',
  config: '접수 시스템 점검 중입니다. 잠시 후 다시 시도해 주세요.',
};
---

<BaseLayout
  title={`상담 신청 | ${site.name}`}
  description="유품정리 상담 신청. 닉네임과 휴대폰 번호만 남겨주시면 비용 범위와 진행 방법을 회신해 드립니다. 상담과 견적에는 비용이 들지 않습니다."
  noindex={false}
>
  <Breadcrumb items={[{ label: '상담 신청' }]} />

  <section class="section">
    <div class="container container--narrow">
      <h1>상담 신청</h1>
      <p class="lead">
        닉네임과 휴대폰 번호만 남겨주셔도 됩니다. 지역과 대략적인 상황을 함께 적어주시면 첫 회신에서
        비용 범위까지 안내드릴 수 있습니다. 상담과 견적에는 비용이 들지 않습니다.
      </p>

      {/* 서버가 ?error= 로 되돌려 보낸 경우에만 보이는 안내. JS 없이 동작한다. */}
      <div id="form-error" class="form-error" role="alert" hidden></div>

      <form class="form" method="POST" action="/api/consult">
        <div class="field">
          <label for="nickname">닉네임 <span class="req">필수</span></label>
          <input
            id="nickname"
            name="nickname"
            type="text"
            required
            maxlength="40"
            autocomplete="nickname"
          />
          <p class="hint">
            실명을 꼭 쓰지 않으셔도 됩니다. 회신 때 부를 호칭이면 충분합니다.
          </p>
        </div>

        <div class="field">
          <label for="phone">휴대폰 번호 <span class="req">필수</span></label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            maxlength="20"
            inputmode="tel"
            autocomplete="tel"
            {/*
              백슬래시(\d·\s)는 Astro 가 속성값에서 삼키고, 하이픈이 든 문자 클래스([- ])는
              브라우저가 pattern 을 v 플래그로 컴파일할 때 깨진다. 둘 다 "패턴이 통째로 무시"
              되는 결과라 잘못된 번호가 그냥 통과한다. 그래서 구분자는 (-| ) 로 적는다.
              어차피 진짜 방어선은 서버(normalizePhone)다.
            */}
            pattern="01[016789](-| )?[0-9]{3,4}(-| )?[0-9]{4}"
            title="01로 시작하는 휴대폰 번호를 입력해 주세요. 예: 010-1234-5678"
            placeholder="010-1234-5678"
          />
          <p class="hint">회신은 이 번호로 문자 또는 전화 드립니다. 광고 문자는 보내지 않습니다.</p>
        </div>

        <div class="field">
          <label for="region">지역</label>
          <input
            id="region"
            name="region"
            type="text"
            maxlength="60"
            placeholder="예: 서울 관악구, 성남시 분당구"
          />
        </div>

        <div class="field">
          <label for="type">필요한 서비스</label>
          <select id="type" name="type">
            <option value="">선택 안 함 / 잘 모르겠음</option>
            {services.map((service) => <option value={service.name}>{service.name}</option>)}
            <option value="기타">기타</option>
          </select>
        </div>

        <div class="field">
          <label for="message">상담 내용</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            maxlength="2000"
            placeholder="주거 형태(원룸·아파트 등), 층수와 엘리베이터 유무, 대략적인 짐의 양, 희망 일정을 적어주시면 범위를 훨씬 좁힐 수 있습니다."
          ></textarea>
        </div>

        {/* 허니팟 — 사람에게는 보이지 않는다. 값이 차 있으면 서버가 봇으로 처리한다. */}
        <div class="honeypot" aria-hidden="true">
          <label for="company">회사명</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="button button--primary" type="submit">상담 신청 보내기</button>

        {/* 별도 동의 절차는 두지 않는다. 상담 회신에 필요한 최소 항목만 받고 고지로 갈음한다. */}
        <p class="hint">
          받는 정보는 {site.privacy.items}뿐입니다. {site.privacy.purpose} 목적으로만 쓰고{' '}
          {site.privacy.retention} 파기합니다.
        </p>
      </form>

      <h2>접수 이후</h2>
      <ol class="steps">
        <li><strong>회신</strong>남겨주신 번호로 연락드려 상황을 확인합니다.</li>
        <li><strong>비용 범위 안내</strong>주거 형태와 짐의 양을 여쭤보고 범위를 좁혀 안내드립니다.</li>
        <li><strong>현장 확인</strong>방문해 물품 양과 반출 동선을 확인합니다. 방문 비용은 없습니다.</li>
        <li><strong>항목별 견적서</strong>작업 항목과 금액을 구분해 서면으로 드립니다.</li>
      </ol>

      <p class="note">
        견적서에 없는 작업은 임의로 진행하지 않습니다. {site.guaranteeShort}
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ errors }}>
    // 서버가 붙여 보낸 ?error= 코드를 사람이 읽을 문장으로 바꾼다.
    const code = new URLSearchParams(location.search).get('error');
    const box = document.getElementById('form-error');
    if (code && box) {
      box.textContent = errors[code] ?? errors.send;
      box.hidden = false;
      box.scrollIntoView({ block: 'center' });
    }
  </script>
</BaseLayout>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 지정하지 않으면 현재 경로로 자동 생성. false 면 canonical 을 내보내지 않는다(404). */
  canonical?: string | false;
  ogImage?: string;
  /** 페이지별 구조화 데이터 (JSON-LD) */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** 칼럼 등 글 페이지는 'article' — article:published_time 메타가 함께 나간다 */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** 접수 완료 페이지 — 네이버 전환 스크립트(신청/예약)를 함께 보낸다 */
  conversion?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL('/og-image.png', Astro.site).href,
  jsonLd = [],
  noindex = false,
  ogType = 'website',
  publishedAt,
  updatedAt,
  conversion = false,
} = Astro.props;

/** 상담 페이지에서는 하단 고정 CTA 를 겹쳐 보여주지 않는다 */
const showMobileCta = !Astro.url.pathname.startsWith(site.consultPath);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* 네이버 서치어드바이저 소유확인 — 삭제하면 등록이 풀린다 */}
    <meta name="naver-site-verification" content="31c67f451d279ad1942783f4c01997f59dbacce4" />
    <meta name="theme-color" content="#16233D" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 칼럼`} href="/rss.xml" />

    {/* 본문: Pretendard Variable(동적 서브셋) / 제목: Noto Serif KR */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {/*
      제목 전용 세리프는 첫 렌더를 막지 않게 늦게 붙인다 (모바일 LCP). 로드 전에는 시스템 세리프로 보인다.
    */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700&display=swap" />
    </noscript>

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {ogType === 'article' && updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {/* 카카오톡·페이스북이 첫 크롤 때 이미지를 바로 잡도록 크기를 명시한다 */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.slogan}`} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class:list={[{ 'has-mobile-cta': showMobileCta }]}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      showMobileCta && (
        <div class="mobile-cta">
          {/* 페이지에 계산기가 있으면 스크립트가 href 를 #estimate 로 바꾼다 */}
          <a class="button button--ghost" href="/cost/#estimate" data-estimate-link>예상 비용</a>
          <a class="button button--primary" href={site.consultPath}>상담 신청</a>
        </div>
      )
    }

    {/* 상담 폼 보강 — 번호 자동 하이픈, 즉시 검증, 중복 전송 방지, 오류 시 입력 복원 (src/scripts/consult-form.ts) */}
    <script>
      import '../scripts/consult-form';
    </script>

    {/* 네이버 애널리틱스 — 서치어드바이저와 같은 계정으로 유입/전환을 본다 */}
    <script is:inline type="text/javascript" src="//wcs.pstatic.net/wcslog.js"></script>
    {
      /*
        접수 완료 페이지에서는 전환(유형 4 = 신청/예약)을 함께 보낸다.
        _nasa 는 wcs_do() 보다 먼저 정의돼 있어야 전환으로 잡힌다.
      */
      conversion && (
        <script is:inline type="text/javascript">
          var _nasa = {};
          if (window.wcs) _nasa['cnv'] = wcs.cnv('4', '1');
        </script>
      )
    }
    <script is:inline type="text/javascript">
      if (!window.wcs_add) var wcs_add = {};
      wcs_add['wa'] = '1adbf5b9a027c40';
      if (window.wcs) {
        wcs_do(typeof _nasa !== 'undefined' ? _nasa : undefined);
      }
    </script>
  </body>
</html>
